@if (Error is not null)
{
    <ErrorBox Error="Error" Retry="More" />
}
else if (Loading)
{
    <Loading />
}
else if (Count == 0)
{
    <div class="empty">Aucun résultat pour cette période.</div>
}
else if (Count < Total)
{
    <button class="button secondary wide" @onclick="More">Afficher plus (@Count / @Total)</button>
}
else
{
    <div class="list-end">@Total résultat@(Total > 1 ? "s" : "")</div>
}

@code {
    [Parameter] public int Count { get; set; }
    [Parameter] public int Total { get; set; }
    [Parameter] public bool Loading { get; set; }
    [Parameter] public ApiException? Error { get; set; }
    [Parameter] public EventCallback More { get; set; }
}
